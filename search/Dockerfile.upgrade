# Fast upgrade: scopus-ai-gpu:1.0 -> 1.1 without rebuilding everything.
#
#   docker build -f Dockerfile.upgrade -t scopus-ai-gpu:1.1 .    (or ./scripts/upgrade_image.sh)
#
# Reuses all layers of the tested 1.0 image (the exported WSL distro grows by
# only this layer) and:
#   1. adds PyMySQL for the embedding service;
#   2. recompiles llama-cpp-python for real GPU architectures.  The 1.0 build
#      had no GPU visible, so llama.cpp was compiled for compute 5.2 only and
#      fell back to slow JIT-compiled kernels on newer GPUs.
#
# --no-deps keeps every other package exactly as tested in 1.0.

FROM scopus-ai-gpu:1.0

RUN python -m pip install --no-cache-dir PyMySQL==1.1.1

# 75 = RTX 20xx / GTX 16xx, 86 = RTX 30xx, 89 = RTX 40xx; the 89 PTX lets newer
# GPUs JIT-compile.  (The PyTorch build in this image needs compute >= 7.5 anyway.)
# GGML_NATIVE=OFF: generic AVX2 build instead of -march=native of the build PC,
# so the image also runs on a different (offline) CPU.
RUN CMAKE_ARGS="-DGGML_CUDA=on -DCMAKE_CUDA_ARCHITECTURES=75-real;86-real;89-real;89-virtual -DGGML_NATIVE=OFF" \
    FORCE_CMAKE=1 CMAKE_BUILD_PARALLEL_LEVEL=6 \
    python -m pip install --no-cache-dir --no-deps --force-reinstall "llama-cpp-python==$(python -c 'import importlib.metadata as m; print(m.version("llama_cpp_python"))')"
