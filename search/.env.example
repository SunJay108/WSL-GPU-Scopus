# =====================================================
# Language model server (service "llm", llama.cpp)
# =====================================================

# Model file in ./models (GGUF). A larger GPU can run a larger model,
# e.g. a 7B or 14B instruct model, for better answers.
LLM_MODEL=qwen2.5-3b-instruct-q4_k_m.gguf
# Answers written at the same time (server slots). Each slot needs LLM_CTX
# tokens of KV cache on the GPU (about 150 MB for this 3B model at 4096);
# raise it on a larger GPU to serve more users at once.
LLM_PARALLEL=1
# Context per answer (sources + question + answer).
LLM_CTX=4096
LLM_GPU_LAYERS=all
LLM_BATCH=512
LLM_THREADS=4

# Greedy decoding keeps answers close to the sources.
LLM_TEMPERATURE=0.0
LLM_REPEAT_PENALTY=1.1
LLM_TOP_P=0.90
LLM_TOP_K=40
# Longest answer in tokens (about 4 characters each).
LLM_ANSWER_TOKENS=900

EMBED_DEVICE=cuda
RERANK_DEVICE=cuda
QDRANT_TIMEOUT=300

# =====================================================
# Index bundles (made by the embedding app on its own PC)
# =====================================================

# Folder the bundle folders are copied into; the admin panel (Index tab) lists
# them. Keep it on a Linux disk: Qdrant reads the snapshot from it.
BUNDLES_DIR=./bundles

# =====================================================
# Scopus search UI (http://localhost:7860)
# =====================================================

# llm = the language model judges whether a question is a research question
# (topic words like "policy" or "attack" are fine in research questions);
# keywords = every keyword in app/search_service/filters.py blocks (old behaviour).
GUARD_MODE=llm

# Reranker score (0..1) of the best paper: below MIN the question is declined
# ("no relevant papers"), below WARN the answer shows a "loosely related" notice.
RELEVANCE_MIN_SCORE=0.1
RELEVANCE_WARN_SCORE=0.3
# Papers each answer is written from (= its references).
ANSWER_SOURCES=5

# Only sentences supported by those papers are shown: support score of the
# sentence against its best source (0..1) >= GROUNDING_MIN_SCORE, and every
# number and name in it must occur in the sources.
GROUNDING=true
GROUNDING_MIN_SCORE=0.3

# Load all models when the service starts (not at the first question).
PRELOAD_MODELS=true

# Suggest three follow-up questions under each answer.
SUGGEST_FOLLOWUPS=true

# Half precision for the search embedding model and reranker on CUDA
# (about 0.8 GB less GPU memory, same ranking).
SEARCH_FP16=true

# Safety models (Qwen3Guard, models/Qwen3Guard-Gen-0.6B and -Stream-0.6B):
# Gen checks every question, Stream checks the answer while it is written.
# Devices: auto (GPU if the model fits next to the others, else CPU), cuda, cpu.
# "Unsafe" is always refused; "Controversial" only in the listed categories
# (Violent, Sexual Content, Self-Harm, Political, PII, Copyright, Illegal Acts,
# Unethical, Jailbreak).
SAFETY_INPUT=true
SAFETY_INPUT_DEVICE=auto
SAFETY_INPUT_CONTROVERSIAL=Political,Jailbreak
SAFETY_OUTPUT=true
SAFETY_OUTPUT_DEVICE=auto
SAFETY_OUTPUT_CONTROVERSIAL=
# Answer tokens in a row judged unsafe before the answer is stopped.
SAFETY_OUTPUT_MIN_TOKENS=2

# Accounts. The first account created becomes the administrator (admin panel:
# users, activity, chats, index import).
# ALLOW_SIGNUP=false: only administrators can add users (admin panel).
ALLOW_SIGNUP=true
# Days a login stays valid.
SESSION_DAYS=7
