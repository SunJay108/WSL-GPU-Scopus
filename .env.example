# =====================================================
# Scopus AI GPU runtime settings
# =====================================================

LLM_CTX=4096
LLM_BATCH=256
LLM_THREADS=4
LLM_GPU_LAYERS=-1

# Limit for ONE generation call.  The search service automatically continues when the
# model hits this boundary, so the final answer can be longer and complete.
LLM_MAX_NEW_TOKENS=512
LLM_MAX_CONTINUATIONS=6

LLM_TEMPERATURE=0.10
LLM_REPEAT_PENALTY=1.18
LLM_TOP_P=0.90
LLM_TOP_K=40

EMBED_DEVICE=cuda
RERANK_DEVICE=cuda
QDRANT_TIMEOUT=300

# =====================================================
# Embedding service (http://localhost:7861)
# =====================================================

# Host folder the embedding UI can browse; mounted at /import in the container.
# Put each MySQL data folder (.frm/.MYD/.MYI files) below it, e.g. ./app/data/mysql.
# A Windows drive can be used from WSL, e.g. IMPORT_DIR=/mnt/d/mysql_exports
IMPORT_DIR=./app/data

# 127.0.0.1 = only this PC can open the embedding UI; 0.0.0.0 = whole network.
EMBED_SERVICE_BIND=127.0.0.1

# Chunks per GPU batch (halved automatically on CUDA out-of-memory) and
# half precision on the GPU (about 4x faster; set false to embed in fp32).
EMBED_BATCH_SIZE=128
EMBED_FP16=true

# Password of the internal MariaDB used to read MyISAM files (not exposed).
MARIADB_ROOT_PASSWORD=scopus-staging

# =====================================================
# Scopus search UI (http://localhost:7860)
# =====================================================

# llm = the language model judges whether a question is a research question
# (topic words like "policy" or "attack" are fine in research questions);
# keywords = every keyword in app/search_service/filters.py blocks (old behaviour).
GUARD_MODE=llm

# Reranker score (0..1) of the best paper: below MIN the question is declined
# ("no relevant papers"), below WARN the answer shows a "loosely related" notice.
RELEVANCE_MIN_SCORE=0.1
RELEVANCE_WARN_SCORE=0.3

# Suggest three follow-up questions under each answer.
SUGGEST_FOLLOWUPS=true

# Half precision for the search embedding model and reranker on CUDA
# (about 0.8 GB less GPU memory, same ranking).
SEARCH_FP16=true

# Safety models (Qwen3Guard, models/Qwen3Guard-Gen-0.6B and -Stream-0.6B):
# Gen checks every question, Stream checks the answer while it is written.
# Devices: auto (GPU if the model fits next to the others, else CPU), cuda, cpu.
# "Unsafe" is always refused; "Controversial" only in the listed categories
# (Violent, Sexual Content, Self-Harm, Political, PII, Copyright, Illegal Acts,
# Unethical, Jailbreak).
SAFETY_INPUT=true
SAFETY_INPUT_DEVICE=auto
SAFETY_INPUT_CONTROVERSIAL=Political,Jailbreak
SAFETY_OUTPUT=true
SAFETY_OUTPUT_DEVICE=auto
SAFETY_OUTPUT_CONTROVERSIAL=
# Answer tokens in a row judged unsafe before the answer is stopped.
SAFETY_OUTPUT_MIN_TOKENS=2

# Accounts (search UI and embedding service). The first account created becomes
# the administrator; only administrators can use the embedding service.
# ALLOW_SIGNUP=false: only administrators can add users (admin panel).
ALLOW_SIGNUP=true
# Days a login stays valid.
SESSION_DAYS=7
