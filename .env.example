# =====================================================
# Scopus AI GPU runtime settings
# =====================================================

LLM_CTX=4096
LLM_BATCH=256
LLM_THREADS=4
LLM_GPU_LAYERS=-1

# Limit for ONE generation call.  query.py automatically continues when the
# model hits this boundary, so the final answer can be longer and complete.
LLM_MAX_NEW_TOKENS=512
LLM_MAX_CONTINUATIONS=6

LLM_TEMPERATURE=0.10
LLM_REPEAT_PENALTY=1.18
LLM_TOP_P=0.90
LLM_TOP_K=40

EMBED_DEVICE=cuda
RERANK_DEVICE=cuda
QDRANT_TIMEOUT=300

# =====================================================
# Embedding service (http://localhost:7861)
# =====================================================

# Host folder the embedding UI can browse; mounted at /import in the container.
# Put each MySQL data folder (.frm/.MYD/.MYI files) below it, e.g. ./app/data/mysql.
# A Windows drive can be used from WSL, e.g. IMPORT_DIR=/mnt/d/mysql_exports
IMPORT_DIR=./app/data

# 127.0.0.1 = only this PC can open the embedding UI; 0.0.0.0 = whole network.
EMBED_SERVICE_BIND=127.0.0.1

# Chunks per GPU batch (halved automatically on CUDA out-of-memory) and
# half precision on the GPU (about 4x faster; set false to embed in fp32).
EMBED_BATCH_SIZE=128
EMBED_FP16=true

# Password of the internal MariaDB used to read MyISAM files (not exposed).
MARIADB_ROOT_PASSWORD=scopus-staging
