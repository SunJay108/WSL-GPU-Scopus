# Settings of the embedding service. Copy to .env and adjust.

# =====================================================
# Folders (host paths)
# =====================================================

# Folder tree the UI can browse; put each MySQL data folder (.frm/.MYD/.MYI
# files) or RIS export below it, e.g. ./data/import/mysql.
# A Windows drive can be used from WSL, e.g. IMPORT_DIR=/mnt/d/mysql_exports
IMPORT_DIR=./data/import

# Where export bundles are written. Keep it on a Linux disk (not /mnt/c...):
# Qdrant writes its snapshots here. Copy finished bundles to a USB drive.
EXPORT_DIR=./data/exports

# =====================================================
# Web UI
# =====================================================

# 127.0.0.1 = only this PC can open the UI; 0.0.0.0 = whole network.
EMBED_SERVICE_BIND=127.0.0.1
EMBED_SERVICE_PORT=7861
# The first account becomes the administrator. Further administrators:
#   docker exec -it embed-service python users.py create-admin NAME
ALLOW_SIGNUP=false
SESSION_DAYS=7

# =====================================================
# Embedding (speed)
# =====================================================

# cuda = GPU (falls back to the CPU when no GPU is visible); cpu = CPU only.
EMBED_DEVICE=cuda
# Chunks per GPU batch; halved automatically on CUDA out-of-memory.
# A GPU with more memory can use 256-512 (somewhat faster).
EMBED_BATCH_SIZE=128
# Half precision on the GPU (about 4x faster, same ranking).
EMBED_FP16=true
# Papers read, embedded and uploaded together. Memory use depends on this,
# not on the number of papers in a table.
INGEST_BATCH=1000

# =====================================================
# Quality check after each ingest
# =====================================================

# New papers looked up again by title (keyword and vector search); 0 = off.
QUALITY_SAMPLE=100

# =====================================================
# Internal services
# =====================================================

QDRANT_TIMEOUT=300
# Password of the internal MariaDB used to read MyISAM files (not exposed).
MARIADB_ROOT_PASSWORD=scopus-staging
